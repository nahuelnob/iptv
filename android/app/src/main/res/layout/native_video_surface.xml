<?xml version="1.0" encoding="utf-8"?>
<!-- NativeVideoPlugin with { surface: 'surface' }: cheaper than a TextureView, but only visible
     where the device's compositor shows a SurfaceView through the transparent WebView. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="false"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black"
    app:surface_type="surface_view"
    app:use_controller="false" />
